# =====================================================================
# Custom Prompt
# For Glyphs: Use MesloLGSDZ Nerd Font Mono
# =====================================================================

# ---------------------------------------------------------------------
# Prompt setup
# ---------------------------------------------------------------------

autoload -Uz vcs_info add-zsh-hook

setopt PROMPT_SUBST

zmodload zsh/datetime 2>/dev/null

# Runtime state
: ${PROMPT_THEME:=dark}
cmd_start=""
last_duration=""
last_status=0

# ---------------------------------------------------------------------
# Theme-aware prompt colors
# ---------------------------------------------------------------------

set_prompt_colors() {
  case "$PROMPT_THEME" in
    light)
      PROMPT_THEME=light
      ;;

    *)
      PROMPT_THEME=dark
      ;;
  esac

  # DARK
  if [[ $PROMPT_THEME == dark ]]; then
    c_sym=15
    c_user=10
    c_host=11
    c_dir=14
    c_gitlabel=15
    c_branch=13
    c_staged=10
    c_unstaged=214
    c_untracked=9
    c_time=111
    c_ok=10
    c_err=9

  # LIGHT
  else
    c_sym=15
    c_user=10
    c_host=11
    c_dir=12
    c_gitlabel=15
    c_branch=13
    c_staged=10
    c_unstaged=166
    c_untracked=9
    c_time=8
    c_ok=10
    c_err=9
  fi

  # Update vcs_info colors
  zstyle ':vcs_info:git:*' stagedstr "%F{$c_staged} %f"
  zstyle ':vcs_info:git:*' unstagedstr "%F{$c_unstaged} %f"

  # Git line:
  # Only appears when inside a git repo because vcs_info_msg_0_ is empty otherwise.
  zstyle ':vcs_info:git:*' formats "
 %F{$c_gitlabel}%f %F{$c_branch}%b%f%c%u"

  # Prompt layout:
  # 1st line: user + host
  # 2nd line: directory
  # 3rd line: git info, only when in a git repo
  # 4th line: command status, only after a command runs
  # 5th line: prompt symbol
  PROMPT='%F{$c_user}%n%f %F{$c_sym}%f %F{$c_host}%m%f
 %F{$c_sym}%f %F{$c_dir}%~%f${vcs_info_msg_0_}$(prompt_status)
 $( [[ $EUID -eq 0 ]] && echo "%F{$c_user}#%f" || echo "%F{$c_user}%f" ) '
}

# ---------------------------------------------------------------------
# ls colors
# ---------------------------------------------------------------------

set_ls_colors() {
  export CLICOLOR=1

  case "$PROMPT_THEME" in
    light)
      export LSCOLORS="exfxcxdxbxegedabagacad"
      export LS_COLORS="di=01;34:ln=01;35:so=01;32:pi=33:ex=01;31:bd=34;46:cd=34;43:su=30;41:sg=30;46:tw=30;42:ow=34;42"
      ;;

    *)
      export LSCOLORS="Gxfxcxdxbxegedabagacad"
      export LS_COLORS="di=01;36:ln=01;35:so=01;32:pi=33:ex=01;33:bd=34;46:cd=34;43:su=30;41:sg=30;46:tw=30;42:ow=34;42"
      ;;
  esac
}

# ---------------------------------------------------------------------
# Theme switching
# ---------------------------------------------------------------------

prompt-dark() {
  export PROMPT_THEME=dark
  set_prompt_colors
  set_ls_colors
  vcs_info
  return 0
}

prompt-light() {
  export PROMPT_THEME=light
  set_prompt_colors
  set_ls_colors
  vcs_info
  return 0
}

# ---------------------------------------------------------------------
# Version control information
# ---------------------------------------------------------------------

zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' check-for-changes true
zstyle ':vcs_info:git+set-message:*' hooks git-counts

+vi-git-counts() {
  local staged_count unstaged_count untracked_count

  # Staged files
  staged_count=$(
    git diff --cached --name-only 2>/dev/null | wc -l | tr -d '[:space:]'
  )

  # Unstaged files
  unstaged_count=$(
    git diff --name-only 2>/dev/null | wc -l | tr -d '[:space:]'
  )

  # Untracked files
  untracked_count=$(
    git ls-files --others --exclude-standard 2>/dev/null | wc -l | tr -d '[:space:]'
  )

  # Replaces %c
  if (( staged_count > 0 )); then
    hook_com[staged]="%F{$c_staged} (${staged_count})%f"
  else
    hook_com[staged]=""
  fi

  # Replaces %u
  local u=""

  if (( unstaged_count > 0 )); then
    u+="%F{$c_unstaged} (${unstaged_count})%f"
  fi

  if (( untracked_count > 0 )); then
    u+="${u:+ }%F{$c_untracked} (${untracked_count})%f"
  fi

  hook_com[unstaged]="$u"
}

# ---------------------------------------------------------------------
# Command execution timer
# ---------------------------------------------------------------------

preexec_timer() {
  cmd_start=$EPOCHREALTIME
}

add-zsh-hook preexec preexec_timer

# ---------------------------------------------------------------------
# Prompt status segment
# ---------------------------------------------------------------------

prompt_status() {
  if [[ -z $last_duration ]]; then
    return
  fi

  if (( last_status == 0 )); then
    echo "
 %F{$c_ok}%f %F{$c_sym}%f %F{$c_time} ${last_duration}s%f"
  else
    echo "
 %F{$c_err}%f %F{$c_sym}%f %F{$c_time} ${last_duration}s%f"
  fi
}

# ---------------------------------------------------------------------
# Before every prompt
# ---------------------------------------------------------------------

precmd_prompt() {
  # Capture this first, before anything else changes $?
  last_status=$?

  # Update last command duration
  if [[ -n $cmd_start ]]; then
    local now=$EPOCHREALTIME
    local elapsed=$(( (now - cmd_start) * 1000 ))

    last_duration=$(printf "%.3f" $((elapsed))e-3)
    cmd_start=""
  else
    last_duration=""
  fi

  # Update git info
  vcs_info
}

add-zsh-hook precmd precmd_prompt

# Initialize prompt and ls colors once
set_prompt_colors
set_ls_colors